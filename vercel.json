{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/logo/(.*)", "dest": "/logo/$1" },
    { "src": "/sample-pdf/(.*)", "dest": "/sample-pdf/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
